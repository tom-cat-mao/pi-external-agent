{
  "name": "pi-external-agent",
  "version": "0.8.0",
  "description": "Pi extension: dispatch coding tasks to other agent CLIs (codex, pi, kimi, codebuddy, claude, reasonix, qoder, dsh) and steer them mid-run",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tom-cat-mao/pi-external-agent"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "src/",
    "skills/",
    "templates/",
    "hooks/codebuddy-readonly.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
